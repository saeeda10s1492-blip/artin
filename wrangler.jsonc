{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "artin",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ea638059-f24d-48af-abb7-667fa96904c6","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "beb1b276c9b74996a305a0810e5284b3" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
